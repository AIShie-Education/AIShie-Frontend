{
  "name": "aishie-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web front end for AIshie Core: one client of the same tool layer agents call over MCP.",
  "scripts": {
    "dev": "vite",
    "dev:local": "AISHIE_API_TARGET=http://localhost:8080 vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "node scripts/gen-api-types.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "eslint src",
    "check": "npm run typecheck && npm run check:i18n && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "element-plus": "^2.14.6",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "jsqr": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
