{
  "name": "aishiteru-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web front end for AIShiteru Core: one client of the same tool layer agents call over MCP.",
  "scripts": {
    "dev": "vite",
    "dev:local": "AISHITERU_API_TARGET=http://localhost:8080 vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "node scripts/gen-api-types.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run typecheck && npm run check:i18n && npm test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "element-plus": "^2.14.6",
    "markdown-it": "^15.0.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
