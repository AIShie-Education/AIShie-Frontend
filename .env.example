# Dev server only: which Core instance /v1 is proxied to.
AISHIE_API_TARGET=https://test.aishie.app
# Dev server only: where /runtime/api, the agent runtime's API, is proxied
# (without the Cookie header). Empty: where Core is, whose server sends that
# path to its runtime. For a runtime on this machine, its API_ADDR, such as
# http://localhost:9091.
AISHIE_RUNTIME_TARGET=

# Built into the app. Leave VITE_API_BASE empty when the front end is served
# from the same origin as Core (behind one reverse proxy), which is what Core
# expects: its session cookie is SameSite=Lax.
VITE_API_BASE=
# Single sign-on is offered as Core says (GET /v1/auth/methods). These two are
# for a Core too old to say: whether to show the button, and its label.
VITE_SSO_ENABLED=false
VITE_SSO_LABEL=
VITE_CORE_PUBLIC_URL=
